DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
# Optional on Railway: RAILWAY_PUBLIC_DOMAIN is auto-added to ALLOWED_HOSTS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to your public URL, e.g. https://your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Admin superuser (optional: ensure_superuser on deploy). seed_rbac also creates/updates
# bootstrap admin Lakindu — see rbac/seed_catalog.py DEFAULT_SUPERUSER.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@fmsc.usj.ac.lk
DJANGO_SUPERUSER_PHONE=+94771234567
DJANGO_SUPERUSER_PASSWORD=change-me-after-first-login

# Evidence must stay private; do not serve MEDIA_ROOT as a public directory.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@localhost
INCIDENT_VIDEO_MAX_BYTES=26214400
INCIDENT_VIDEO_MAX_SECONDS=120
FFPROBE_PATH=ffprobe
