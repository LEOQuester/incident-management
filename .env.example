DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
# Optional on Railway: RAILWAY_PUBLIC_DOMAIN is auto-added to ALLOWED_HOSTS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to your public URL, e.g. https://your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: create/reset superuser on each deploy (set on Railway, then remove password after first login)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-after-first-login
DJANGO_SUPERUSER_EMAIL=admin@fmsc.usj.ac.lk
